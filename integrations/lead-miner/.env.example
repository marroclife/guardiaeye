# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY: Required for Google Places API prospecting and location services.
GOOGLE_MAPS_API_KEY=""

# DATABASE_URL: PostgreSQL connection string for Prisma ORM.
DATABASE_URL="postgresql://user:password@localhost:5432/luxurylead?schema=public"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================
# NEXUS AI INTEGRATION
# Conexão com o banco do NEXO's Eye CRM (Supabase)
# ============================================================
NEXUS_SUPABASE_URL="https://jifjcajdzpwqttgkswyp.supabase.co"
# Service Role Key — NUNCA commitar. Apenas backend/server.ts usa.
# Pegar em: Supabase Dashboard > Project Settings > API > service_role key
NEXUS_SUPABASE_SERVICE_KEY=""
